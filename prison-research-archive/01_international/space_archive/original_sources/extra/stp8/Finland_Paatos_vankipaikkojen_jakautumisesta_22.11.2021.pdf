      <script>
    var ajaxurl = 'https://www.rikosseuraamus.fi/wp/wp-admin/admin-ajax.php';
    
    function logCookieAction(action) {
      var xhr = new XMLHttpRequest();
      xhr.open('POST', ajaxurl, true);
      xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
      xhr.send('action=log_cookie_deletion&cookie_action=' + encodeURIComponent(action));
    }
    
    (function() {
      function deleteCookie(name) {
        // Try multiple deletion approaches to ensure cookie is removed
        // Delete with current domain
        document.cookie = name + '=; Max-Age=0; path=/; domain=' + location.hostname + ';';
        // Delete with dot-prefixed domain
        document.cookie = name + '=; Max-Age=0; path=/; domain=.' + location.hostname + ';';
        // Delete without domain specification
        document.cookie = name + '=; Max-Age=0; path=/;';
        // Delete with expires in the past
        document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=' + location.hostname + ';';
        document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=.' + location.hostname + ';';
        document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/;';
      }
      if (document.cookie.split(';').some((item) => item.trim().startsWith('style='))) {
        deleteCookie('style');
        logCookieAction('deletion attempted');
        console.log('style cookie deletion attempted');
        // Verify if cookie was actually deleted
        setTimeout(function() {
          if (!document.cookie.split(';').some((item) => item.trim().startsWith('style='))) {
            logCookieAction('deletion successful');
            console.log('style cookie successfully deleted');
          } else {
            logCookieAction('deletion failed');
            console.log('style cookie still exists after deletion attempt');
          }
        }, 100);
      }
    })();
  </script>
