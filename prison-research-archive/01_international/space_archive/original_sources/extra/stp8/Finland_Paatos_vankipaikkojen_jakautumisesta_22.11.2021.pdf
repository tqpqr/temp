        .findkit--all-results-shown {
          color: black;
          margin-bottom: 1rem;
        }

        .findkit--modal {
          background-color: transparent;
          top: 7vh;

          .findkit--content,
          .findkit--header {
            max-width: 1000px !important;
            padding: 0 5rem;

            @media (max-width: 768px) {
              padding: 0 1rem;
            }
          }

          .findkit--header {
            padding: 0 5.7rem;

            @media (max-width: 768px) {
              padding: 0 1.7rem;
            }
          }
        }

        .findkit--close-button {
          color: var(--wp--preset--color--primary);
          cursor: pointer;
        }

        .findkit--load-more-button,
        .findkit--footer-spinner {
          display: none;
        }

        .findkit-hit {
          padding: 0 10px;
        }

        .button {
          height: calc(100% - 20px);
          position: absolute;
          right: 0;
          top: 50%;
          transform: translateY(-50%);
          background-color: var(--wp--preset--color--primary);
          color: white;
          padding: 10px 15px;
          border-top-right-radius: 4px;
          border-bottom-right-radius: 4px;

          &.all-results-button {
            position: relative;
            top: 0;
            width: fit-content;
            margin: 1rem 0.75rem;
            margin-top: 1.5rem;
            text-decoration: none;
            margin-bottom: 5rem;
            border-radius: 4px;
            display: flex;
            align-items: center;

            svg {
              margin-left: 20px;
              width: 17.5px;
              height: 17.5px;
            }
          }

          &.search-button {
            width: 2.5rem;

            span {
              display: none;
            }

            &::after {
              content: '';
              background-image: url('/app/themes/oikeus/resources/images/icons/icon-search-white.svg');
              width: 20px;
              height: 20px;
              display: block;
              background-size: contain;
              background-position: center;
              background-repeat: no-repeat;
              position: absolute;
              top: 0;
              left: 0;
              margin: auto;
              right: 0;
              bottom: 0;
            }
          }
        }

        .header-container {
          padding-top: 1rem;
          display: flex;
          justify-content: space-between;
          align-items: center;

          p {
            font-size: 24px;
            font-weight: bold;
            margin: 0;
          }
        }

        .search-container {
          position: relative;
          margin-top: 1rem;
          display: flex;
          margin-bottom: 2rem;

          input {
            width: 100%;
            border-radius: 10px;
            padding: 15px 15px;
            border: 1px solid gray;
            font-size: 18px;
            outline: none;

            &:focus {
              border: 1px solid var(--wp--preset--color--primary);
            }
          }
        }

        .hit-container {
          border-bottom: 1px solid var(--wp--preset--color--primary);
          padding-bottom: 1rem;
          margin-bottom: 1rem;

          .head-container {
            display: flex;
            align-items: center;
            
            a {
              widht: fit-content;
              color: black;
              font-weight: bold;
              font-size: 18px;
              display: flex;
              align-items: center;

              &[target="_self"] {
                &::after {
                  content: '';
                  background-image: url('/app/themes/oikeus/resources/images/icons/icon-chevron-right-black.svg');
                  width: 15px;
                  height: 15px;
                  display: block;
                  background-size: contain;
                  background-position: center;
                  background-repeat: no-repeat;
                  margin-left: 8px;
                  flex-shrink: 0;
                }
              }

              &[target="_blank"] {
                &::after {
                  content: '';
                  background-image: url('/app/themes/oikeus/resources/images/icons/icon-outer-link.svg');
                  width: 17px;
                  height: 17px;
                  display: block;
                  background-size: contain;
                  background-position: center;
                  background-repeat: no-repeat;
                  margin-left: 8px;
                  flex-shrink: 0;
                }
              }

              &.file-pdf {
                &::after {
                  content: '';
                  background-image: url('/app/themes/oikeus/resources/images/icons/icon-file.svg');
                  width: 17px;
                  height: 17px;
                  display: block;
                  background-size: contain;
                  background-position: center;
                  background-repeat: no-repeat;
                  margin-left: 8px;
                  flex-shrink: 0;
                }
              }
            }

            p {
              margin: 0;
              padding: 0 10px;
              font-size: 16px;
            }
          }

          .findkit--highlight {
            padding: 10px 0;

            .findkit--em {
              background-color: white;
              color: black;
              font-weight: bold;
              font-style: normal;
              padding: 0;
            }

            a {
              &:hover,
              &:focus,
              &:focus-within {
                color: var(--wp--preset--color--primary);
                outline: -webkit-focus-ring-color auto 1px;
              }
            }
          }

          .url-container {
            a {
              color: var(--wp--preset--color--primary);
            }
          }
        }
      `,
    });

